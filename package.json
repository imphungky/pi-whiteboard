{
  "name": "pi-whiteboard-extension",
  "version": "0.1.0",
  "description": "Pi extension with a bundled local whiteboard web app",
  "type": "module",
  "pi": {
    "extensions": [
      "./pi-extension/index.ts"
    ]
  },
  "piWhiteboard": {
    "webRoot": "dist/web"
  },
  "main": "./dist/extension/pi-extension/src/index.js",
  "exports": {
    ".": "./dist/extension/pi-extension/src/index.js"
  },
  "files": [
    "pi-extension/index.ts",
    "pi-extension/src",
    "shared/board-protocol/src",
    "dist/extension",
    "dist/web",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --config whiteboard-app/vite.config.ts",
    "build:web": "tsc -p whiteboard-app/tsconfig.app.json && vite build --config whiteboard-app/vite.config.ts",
    "build:extension": "tsc -p tsconfig.package.json",
    "build": "npm run build:web && npm run build:extension",
    "test": "vitest run --config vitest.config.ts whiteboard-app/src pi-extension/test",
    "typecheck": "npm run build:extension && tsc -p whiteboard-app/tsconfig.app.json --noEmit",
    "test:debug": "vitest run --config vitest.config.ts --no-file-parallelism --inspect-brk pi-extension/test",
    "pi:debug": "node --inspect \"%APPDATA%/npm/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js\" --extension ./pi-extension"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "websocket-ts": "^3.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
